flow rpa-workflow-gate {
  name: "RPA Workflow Gate",
  version: "1.0.0",
};

trigger manualStart: start;

action runRobot: uipath.core.rpa-workflow.7648307a-b180-467c-81f3-06f49a87313b@1.0.0 {
  label: "RPA Workflow12Feb",
  rawInputs: { newArgument: "" },
  resource: {
    resource: "process",
    resourceSubType: "Process",
    resourceKey: "Shared/sol_with_all_projects.RPA Workflow12Feb",
    orchestratorType: "process",
    serviceType: "Orchestrator.StartJob",
    section: "Published",
  },
  resourceBindings: {
    name: "bRpaName",
    folderPath: "bRpaFolder",
  },
  outputs: {
    error: {
      type: "object",
      description: "Error information if the node fails",
      source: "=Error",
      var: "error",
    },
  },
  fixture: { output: { jobId: "dry-run-job" } },
};

action robotStarted: mock {
  fixture: { route: "started" },
};

action robotEscalated: mock {
  fixture: { route: "escalated" },
};

async function main(): Promise<void> {
  const runRobotData: string = await executeNode(runRobot, JSON.stringify({ newArgument: "" }));
  const result: json = JSON.parse(runRobotData);
  const output: json = result.output;
  const jobId: string = output.jobId;
  if (jobId !== "") {
    await executeNode(robotStarted, "{}");
  } else {
    await executeNode(robotEscalated, "{}");
  }
}
