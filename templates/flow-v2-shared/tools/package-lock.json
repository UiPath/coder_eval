{
  "name": "flow-v2-tools-bundle",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "flow-v2-tools-bundle",
      "version": "0.0.0",
      "workspaces": [
        "fil",
        "v1-to-v2",
        "v2-to-v1",
        "flow-run"
      ]
    },
    "fil": {
      "name": "fil-compiler",
      "version": "1.0.0",
      "license": "MIT",
      "bin": {
        "filc": "dist/index.js"
      }
    },
    "flow-run": {
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "fil-compiler": "file:../fil",
        "wabt": "^1.0.39"
      },
      "bin": {
        "flow-run": "dist/cli.js"
      }
    },
    "node_modules/fil-compiler": {
      "resolved": "fil",
      "link": true
    },
    "node_modules/flow-run": {
      "resolved": "flow-run",
      "link": true
    },
    "node_modules/v1-to-v2": {
      "resolved": "v1-to-v2",
      "link": true
    },
    "node_modules/v2-to-v1": {
      "resolved": "v2-to-v1",
      "link": true
    },
    "node_modules/wabt": {
      "version": "1.0.39",
      "resolved": "https://registry.npmjs.org/wabt/-/wabt-1.0.39.tgz",
      "integrity": "sha512-ba+dRL/75VQQY7RkU/CgriGbkoWAfS8TDyUlJfJhJ8KhtXgMl5dhNvoPNUcQ9IWRhW8u41glMSuZeTvsYq2rRg==",
      "license": "Apache-2.0",
      "bin": {
        "wasm-decompile": "bin/wasm-decompile",
        "wasm-interp": "bin/wasm-interp",
        "wasm-objdump": "bin/wasm-objdump",
        "wasm-stats": "bin/wasm-stats",
        "wasm-strip": "bin/wasm-strip",
        "wasm-validate": "bin/wasm-validate",
        "wasm2c": "bin/wasm2c",
        "wasm2wat": "bin/wasm2wat",
        "wat2wasm": "bin/wat2wasm"
      }
    },
    "v1-to-v2": {
      "version": "0.1.0",
      "dependencies": {
        "fil-compiler": "file:../fil"
      },
      "bin": {
        "v1tov2": "dist/cli.js"
      }
    },
    "v2-to-v1": {
      "version": "0.1.0",
      "dependencies": {
        "fil-compiler": "file:../fil",
        "v1-to-v2": "file:../v1-to-v2"
      },
      "bin": {
        "v2tov1": "dist/cli.js"
      }
    }
  }
}
