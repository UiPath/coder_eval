{
  "name": "Release Monitor",
  "id": "00000000-0000-0000-0000-000000000001",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "When clicking 'Test workflow'"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "a1", "name": "repos", "value": "=[\"nodejs/node\", \"facebook/react\"]", "type": "array"}
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0],
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Init repos"
    },
    {
      "parameters": {
        "fieldToSplitOut": "repos",
        "options": {}
      },
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0],
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Split repos"
    },
    {
      "parameters": {
        "options": {"reset": false}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [660, 0],
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Loop Over Items"
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repos }}/releases/latest",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0],
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "Fetch Latest Release"
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "typeValidation": "strict"},
          "conditions": [
            {
              "leftValue": "={{ $json.published_at }}",
              "rightValue": "={{ $now.minus(7, 'days').toISO() }}",
              "operator": {"type": "string", "operation": "after"}
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 0],
      "id": "66666666-6666-6666-6666-666666666666",
      "name": "Is New?"
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": false, "typeValidation": "strict"},
          "conditions": [
            {
              "leftValue": "={{ $json.name }}{{ $json.body }}",
              "rightValue": "cve",
              "operator": {"type": "string", "operation": "contains"}
            },
            {
              "leftValue": "={{ $json.name }}{{ $json.body }}",
              "rightValue": "security",
              "operator": {"type": "string", "operation": "contains"}
            }
          ],
          "combinator": "or"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, -80],
      "id": "77777777-7777-7777-7777-777777777777",
      "name": "Is Security?"
    },
    {
      "parameters": {
        "resource": "issue",
        "project": {"__rl": true, "mode": "list", "value": "MAESTRO"},
        "summary": "=Security release: {{ $json.tag_name }}",
        "issueType": {"__rl": true, "mode": "list", "value": "10001"},
        "additionalFields": {"description": "={{ $json.body }}"}
      },
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [1540, -200],
      "id": "88888888-8888-8888-8888-888888888888",
      "name": "Create Jira Issue"
    },
    {
      "parameters": {
        "resource": "message",
        "select": "user",
        "user": {"__rl": true, "mode": "id", "value": "U_DUSTIN"},
        "messageType": "text",
        "text": "=Security release: {{ $json.html_url }}",
        "otherOptions": {}
      },
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [1540, -80],
      "id": "99999999-9999-9999-9999-999999999999",
      "name": "Slack DM (security)"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "subject": "=[SECURITY] released {{ $json.tag_name }}",
        "bodyContent": "={{ $json.body }}",
        "bodyContentType": "Text",
        "toRecipients": "dustin.metzgar@uipath.com",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [1540, 40],
      "id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
      "name": "Outlook Email (security)"
    },
    {
      "parameters": {
        "resource": "message",
        "select": "user",
        "user": {"__rl": true, "mode": "id", "value": "U_DUSTIN"},
        "messageType": "text",
        "text": "=Release: {{ $json.tag_name }}",
        "otherOptions": {}
      },
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [1540, 200],
      "id": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
      "name": "Slack DM (normal)"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "subject": "=Release: {{ $json.tag_name }}",
        "bodyContent": "={{ $json.body }}",
        "bodyContentType": "Text",
        "toRecipients": "dustin.metzgar@uipath.com",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [1540, 320],
      "id": "cccccccc-cccc-cccc-cccc-cccccccccccc",
      "name": "Outlook Email (normal)"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "subject": "Daily release rollup",
        "bodyContent": "=Summary across all repos",
        "bodyContentType": "Text",
        "toRecipients": "dustin.metzgar@uipath.com",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [880, 520],
      "id": "dddddddd-dddd-dddd-dddd-dddddddddddd",
      "name": "Outlook Digest"
    }
  ],
  "connections": {
    "When clicking 'Test workflow'": {"main": [[{"node": "Init repos", "type": "main", "index": 0}]]},
    "Init repos": {"main": [[{"node": "Split repos", "type": "main", "index": 0}]]},
    "Split repos": {"main": [[{"node": "Loop Over Items", "type": "main", "index": 0}]]},
    "Loop Over Items": {
      "main": [
        [{"node": "Fetch Latest Release", "type": "main", "index": 0}],
        [{"node": "Outlook Digest", "type": "main", "index": 0}]
      ]
    },
    "Fetch Latest Release": {"main": [[{"node": "Is New?", "type": "main", "index": 0}]]},
    "Is New?": {
      "main": [
        [{"node": "Is Security?", "type": "main", "index": 0}],
        [{"node": "Loop Over Items", "type": "main", "index": 0}]
      ]
    },
    "Is Security?": {
      "main": [
        [
          {"node": "Create Jira Issue", "type": "main", "index": 0},
          {"node": "Slack DM (security)", "type": "main", "index": 0},
          {"node": "Outlook Email (security)", "type": "main", "index": 0}
        ],
        [
          {"node": "Slack DM (normal)", "type": "main", "index": 0},
          {"node": "Outlook Email (normal)", "type": "main", "index": 0}
        ]
      ]
    },
    "Create Jira Issue": {"main": [[{"node": "Loop Over Items", "type": "main", "index": 0}]]},
    "Slack DM (security)": {"main": [[{"node": "Loop Over Items", "type": "main", "index": 0}]]},
    "Outlook Email (security)": {"main": [[{"node": "Loop Over Items", "type": "main", "index": 0}]]},
    "Slack DM (normal)": {"main": [[{"node": "Loop Over Items", "type": "main", "index": 0}]]},
    "Outlook Email (normal)": {"main": [[{"node": "Loop Over Items", "type": "main", "index": 0}]]}
  }
}
