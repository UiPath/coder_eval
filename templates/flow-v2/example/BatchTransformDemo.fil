// BatchTransformDemo - OOTB Batch Transform demo.
// Shows trigger-bound opaque file input metadata, canonical attachment-handle
// wiring, outputColumns array shape, and file-handle dry-run fixture.

flow batch-transform-demo {
  name: "Batch Transform Demo",
  version: "1.0.0",
};

trigger manualStart: start;

action categorizeRows: uipath.pattern.batch-transform@1.0 {
  label: "Categorize Rows",
  rawInputs: {
    attachment: "=js:$vars.manualStart.output.csvFile",
    prompt: "Classify each row by category and write a one-line summary.",
    enableWebSearchGrounding: false,
    outputColumns: [
      { name: "Category", description: "One of: Utility, Software, Travel, Other" },
      { name: "Summary", description: "Plain-English one-line summary of the row" },
    ],
  },
  outputs: {
    output: { type: "file", source: "=response", var: "output" },
    error: { type: "object", source: "=Error", var: "error" },
  },
  fixture: {
    FullName: "categorized.csv",
    Id: "dry-run-batch-transform-output",
    MimeType: "text/csv",
    Metadata: {},
  },
};

async function main(csvFile: file): Promise<json> {
  const categorizeRowsData: string = await executeNode(categorizeRows, "{}");
  return ({
    result: JSON.parse(categorizeRowsData),
  });
}
