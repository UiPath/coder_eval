// QueueOperationsDemo - OOTB Orchestrator Queue actions demo.
// Shows queue resource bindings, object itemData in FIL, and dry-run fixtures.

flow queue-operations-demo {
  name: "Queue Operations Demo",
  version: "1.0.0",
};

trigger manualStart: start;

action enqueueInvoice: core.action.queue.create@1.0 {
  label: "Enqueue Invoice",
  resource: {
    resource: "queue",
    resourceKey: "queue-key-001",
    serviceType: "Orchestrator.CreateQueueItem",
  },
  resourceBindings: { name: "bQueueName", folderPath: "bQueueFolder" },
  rawInputs: {
    queue: { name: "InvoiceProcessingQueue", folderPath: "Shared", key: "queue-key-001" },
    itemData: { invoiceId: "INV-1001", amount: 123.45, source: "flow-v2-eval" },
    priority: "High",
    reference: "INV-1001",
    deferDate: "",
    dueDate: "2026-06-01T17:00:00Z",
  },
  outputs: {
    output: { type: "object", source: "=response", var: "output" },
    error: { type: "object", source: "=Error", var: "error" },
  },
  fixture: { Id: "dry-run-queue-item", Status: "New", Reference: "INV-1001" },
};

action processInvoiceAndWait: core.action.queue.create-and-wait@1.0 {
  label: "Process Invoice And Wait",
  resource: {
    resource: "queue",
    resourceKey: "queue-key-001",
    serviceType: "Orchestrator.CreateAndWaitForQueueItem",
  },
  resourceBindings: { name: "bQueueName", folderPath: "bQueueFolder" },
  rawInputs: {
    queue: { name: "InvoiceProcessingQueue", folderPath: "Shared", key: "queue-key-001" },
    itemData: { invoiceId: "INV-1002", amount: 987.65, needsResult: true },
    priority: "Normal",
    reference: "INV-1002",
    deferDate: "",
    dueDate: "2026-06-02T17:00:00Z",
  },
  outputs: {
    output: { type: "object", source: "=response", var: "output" },
    error: { type: "object", source: "=Error", var: "error" },
  },
  fixture: { Id: "dry-run-processed-item", Status: "Successful", Output: { approved: true } },
};

async function main(): Promise<json> {
  const createdRaw: string = await executeNode(enqueueInvoice, "{}");
  const processedRaw: string = await executeNode(processInvoiceAndWait, "{}");
  return ({
    created: JSON.parse(createdRaw),
    processed: JSON.parse(processedRaw),
  });
}
