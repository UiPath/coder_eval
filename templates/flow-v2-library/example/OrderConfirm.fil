// OrderConfirm — minimal 2-connector example: list emails, branch on count,
// send a Slack DM. Good for first reading.

flow order-confirm {
  name: "Order Confirm",
  version: "1.0.0",
};

trigger manualStart: start;

action getEmails: uipath.connector.uipath-microsoft-outlook365.get-email-list@1.0.0 {
  binding: "bOutlook",
  folderBinding: "bFolderKey",
  label: "Get Email List",
};

action sendSlackMessage: uipath.connector.uipath-salesforce-slack.send-message-to-channel@1.0.0 {
  binding: "bSlack",
  folderBinding: "bFolderKey",
  label: "Send Slack Message",
};

async function main(): Promise<void> {
  const getEmailsData: string = await executeNode(
    getEmails,
    JSON.stringify({ parentFolderId: "inbox", unReadOnly: true })
  );
  const emails: json = JSON.parse(getEmailsData);
  if (emails.length > 0) {
    const subject: string = (emails[0].subject ?? "(no subject)");
    await executeNode(
      sendSlackMessage,
      JSON.stringify({
        send_as: "bot",
        channel: "#alerts",
        messageToSend: ("New email: " + subject),
      })
    );
  }
}
