# Claude Code Plugin Configuration (optional)
# Base directory for Claude Code plugins - used to substitute $UIPATH_PLUGIN_MARKETPLACE_DIR in task YAML
# UIPATH_PLUGIN_MARKETPLACE_DIR=<path-to-claude-code-plugins>

# UiPath settings
UIPATH_FOLDER_PATH="Shared"

# Anthropic API Key (required for Claude Code agent only, NOT for LLM reviewer, which runs through LLM-GW)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Logging Configuration (optional)
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_TO_FILE=false  # Set to true to enable file logging

# LLM Gateway Configuration (for LLM reviewer - ALL models accessed via Gateway)
# All LLM reviewer calls use UiPath LLM Gateway with LangChain integration
# Supports Anthropic, OpenAI, and other models through unified interface
# Model naming: anthropic.claude-3-5-sonnet-20240620-v1:0, gpt-4o-2024-08-06, etc.

# export it before running `make install`
# needed for installing LLMGW client from the private index
# UV_INDEX_UIPATH_USERNAME=""
# UV_INDEX_UIPATH_PASSWORD="<your_uv_index_password_here>"

# Needed for installing UiPath CLI from the Github Packages registry
# In order to install from the UiPath private NPM registry you need to:
# Create a GitHub PAT *classic* token (https://github.com/settings/tokens), with the following:
# - read:packages (to download packages)
# - repo (for private repos)
# - Expiration: less then 365 days
# - Configure SSO for UiPath
GH_NPM_REGISTRY_TOKEN="<your_github_token_here>"

# API Backend (direct, bedrock, or proxy — default: direct)
# API_BACKEND=direct
#
# Under API_BACKEND=direct, the agent uses whatever credential the Claude Agent
# SDK picks up (ANTHROPIC_API_KEY > CLAUDE_CODE_OAUTH_TOKEN > cached `claude login`).
# The `llm_judge` criterion calls the Anthropic SDK directly, which only honors
# ANTHROPIC_API_KEY. To make subscription-only setups work, the judge transport
# falls back to the LLM Gateway when ANTHROPIC_API_KEY is unset but the LLMGW_*
# credential set is configured. Precedence:
#   - ANTHROPIC_API_KEY set                                 → judge uses api.anthropic.com
#   - ANTHROPIC_API_KEY unset + full LLMGW_* set            → judge uses LLM Gateway
#   - neither set                                           → run starts; any enabled
#                                                             llm_judge criterion fails
#                                                             at dispatch with a clear error
# The resolved transport is logged at startup ("API routing: anthropic_direct
# (judge transport: …)") and recorded in EvaluationResult.environment_info.

# LLM Gateway Proxy settings (used when API_BACKEND=proxy)
LLMGW_URL="https://alpha.uipath.com/"
LLMGW_CLIENT_ID="<your_llmgw_client_id_here>"
LLMGW_CLIENT_SECRET="<your_llmgw_client_secret_here>"
LLMGW_SEMANTIC_ORG_ID="<your_org_id_here>"
LLMGW_SEMANTIC_TENANT_ID="<your_tenant_id_here>"
LLMGW_SEMANTIC_USER_ID="<your_user_id_here>"
LLMGW_REQUESTING_PRODUCT="agent-gym"
LLMGW_REQUESTING_FEATURE="agent-gym-local"
LLMGW_TIMEOUT_SECONDS=290

# AWS Bedrock settings (used when API_BACKEND=bedrock)
# AWS_BEARER_TOKEN_BEDROCK="<your_bedrock_bearer_token_here>"
# AWS_REGION="us-east-1"
# BEDROCK_MODEL="eu.anthropic.claude-sonnet-4-5-20250929-v1:0"
# BEDROCK_SMALL_MODEL="eu.anthropic.claude-haiku-4-5"

# Agent Defaults (CLI flags override these; these override task YAML values)
# DEFAULT_AGENT_MODEL=claude-sonnet-4-20250514
# DEFAULT_PERMISSION_MODE=bypassPermissions
# DEFAULT_MAX_TURNS=50

# Slack notifications (optional, used by dashboard/scripts/ci/daily.sh).
# When set, the cron posts a mechanical metrics summary after each run via
# Slack Workflow Builder webhook. Empty = silent runs (no notification).
# SLACK_WEBHOOK_URL=

# UiPath CLI plugin-discovery pin (MST-9795). When unset, the sandbox auto-derives
# the canonical `node_modules/@uipath` from the resolved `uip` binary at setup
# time. Operators on dedicated eval hosts can pin explicitly to override.
# PLUGIN_TOOLS_DIR=/path/to/node_modules/@uipath
#
# DESTRUCTIVE eval-host flag: when truthy (`1`/`true`/`yes`), the sandbox deletes
# `$HOME/node_modules/@uipath` at setup to clear sibling-task pollution. Refuses
# to act if `$HOME` resolves to filesystem root or the target escapes `$HOME`.
# Off by default. Do NOT enable on developer workstations.
# CODER_EVAL_REMEDIATE_HOME_PLUGINS=0
