        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "text": {"type": "string", "description": "Text to summarize"},
          "max_sentences": {"type": "integer", "default": 3, "description": "Maximum sentences in summary"}
        },
        "required": ["text"]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "summary": {"type": "string"},
          "key_points": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  ]
}
