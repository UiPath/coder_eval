{
  "entryPoints": [
    {
      "filePath": "main.py",
      "uniqueId": "convert",
      "type": "function",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "amount": {"type": "number", "description": "Amount in USD"},
          "target_currency": {"type": "string", "description": "Target currency code (EUR, GBP, JPY)"}
        },
        "required": ["amount", "target_currency"]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "converted_amount": {"type": "number"},
          "rate": {"type": "number"}
        }
      }
    }
  ]
}
