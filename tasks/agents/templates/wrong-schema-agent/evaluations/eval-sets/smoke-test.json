{
  "version": "1.0",
  "id": "reverser-smoke",
  "name": "String Reverser Smoke Test",
  "evaluatorRefs": ["ExactMatchEvaluator"],
  "evaluations": [
    {
      "id": "test-hello",
      "name": "Reverse hello",
      "inputs": {"text": "hello"},
      "evaluationCriterias": {
        "ExactMatchEvaluator": {
          "expectedOutput": {"reversed_text": "olleh"}
        }
      }
    },
    {
      "id": "test-palindrome",
      "name": "Palindrome stays same",
      "inputs": {"text": "racecar"},
      "evaluationCriterias": {
        "ExactMatchEvaluator": {
          "expectedOutput": {"reversed_text": "racecar"}
        }
      }
    }
  ]
}
