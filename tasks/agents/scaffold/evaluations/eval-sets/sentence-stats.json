{
  "version": "1.0",
  "id": "sentence-stats-eval",
  "name": "Sentence Stats Evaluation",
  "evaluatorRefs": ["ExactMatchEvaluator"],
  "evaluations": [
    {
      "id": "basic-two-sentences",
      "name": "Two sentences with period separation",
      "inputs": {"text": "Hello world. How are you?"},
      "evaluationCriterias": {
        "ExactMatchEvaluator": {
          "expectedOutput": {"character_count": 25, "word_count": 5, "sentence_count": 2}
        }
      }
    },
    {
      "id": "single-sentence",
      "name": "Single sentence",
      "inputs": {"text": "The quick brown fox jumps over the lazy dog."},
      "evaluationCriterias": {
        "ExactMatchEvaluator": {
          "expectedOutput": {"character_count": 44, "word_count": 9, "sentence_count": 1}
        }
      }
    },
    {
      "id": "empty-string",
      "name": "Empty input",
      "inputs": {"text": ""},
      "evaluationCriterias": {
        "ExactMatchEvaluator": {
          "expectedOutput": {"character_count": 0, "word_count": 0, "sentence_count": 0}
        }
      }
    }
  ]
}
