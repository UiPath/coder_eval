              ],
              "script": "($collection, $vars, $metadata) => {\n  const filterRules = [{\"field\":\"autonomousAgent1.requiresReleaseNote\",\"condition\":\"equals\",\"value\":\"true\"}];\n  const logicalOperation = \"and\";\n\n  const getFieldValue = (item, fieldName) => {\n    if (item === null || item === undefined || typeof item !== 'object') return undefined;\n    if (fieldName in item) return item[fieldName];\n    const parts = fieldName.split('.');\n    let current = item;\n    for (const part of parts) {\n      if (current === null || current === undefined || typeof current !== 'object') return undefined;\n      current = current[part];\n    }\n    return current;\n  };\n\n  const normalizeValue = (val, referenceVal) => {\n    if (typeof val === typeof referenceVal) return val;\n    if (typeof referenceVal === 'number' && typeof val === 'string') {\n      const num = Number(val);\n      if (!isNaN(num)) return num;\n    }\n    if (typeof referenceVal === 'boolean' && typeof val === 'string') {\n      if (val.toLowerCase() === 'true') return true;\n      if (val.toLowerCase() === 'false') return false;\n    }\n    return val;\n  };\n\n  const applyCondition = (value, condition, compareValue) => {\n    const cv = normalizeValue(compareValue, value);\n    switch (condition) {\n      case 'equals':\n        return value === cv;\n      case 'not_equals':\n        return value !== cv;\n      case 'greater_than':\n        return value > cv;\n      case 'less_than':\n        return value < cv;\n      case 'greater_equal':\n        return value >= cv;\n      case 'less_equal':\n        return value <= cv;\n      case 'contains':\n        return String(value).includes(String(compareValue));\n      case 'starts_with':\n        return String(value).startsWith(String(compareValue));\n      case 'ends_with':\n        return String(value).endsWith(String(compareValue));\n      case 'is_null':\n        return value === null || value === undefined;\n      case 'is_not_null':\n        return value !== null && value !== undefined;\n      default:\n        return true;\n    }\n  };\n\n  const matchesFilter = (item) => {\n    const results = filterRules.map(rule => {\n      const value = getFieldValue(item, rule.field);\n      return applyCondition(value, rule.condition, rule.value);\n    });\n\n    return logicalOperation === 'or'\n      ? results.some(r => r)\n      : results.every(r => r);\n  };\n\n  if (!Array.isArray($collection)) return $collection;\n  return $collection.filter(item => matchesFilter(item));\n}"
            },
            "isCollapsed": false
          }
        ],
