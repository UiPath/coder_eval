                }
              ],
              "keepOriginalFields": false,
              "script": "($collection, $vars, $metadata) => {\n  const mappings = [{\"field\":\"id\",\"transformation\":\"copy\",\"renameTo\":\"\"},{\"field\":\"fields.description\",\"transformation\":\"copy\",\"renameTo\":\"description\"},{\"field\":\"fields.priority.name\",\"transformation\":\"copy\",\"renameTo\":\"priority\"},{\"field\":\"key\",\"transformation\":\"copy\",\"renameTo\":\"\"},{\"field\":\"fields.summary\",\"transformation\":\"copy\",\"renameTo\":\"summary\"}];\n\n  const getFieldValue = (item, fieldName) => {\n    if (item === null || item === undefined || typeof item !== 'object') return undefined;\n    if (fieldName in item) return item[fieldName];\n    const parts = fieldName.split('.');\n    let current = item;\n    for (const part of parts) {\n      if (current === null || current === undefined || typeof current !== 'object') return undefined;\n      current = current[part];\n    }\n    return current;\n  };\n\n  const hasField = (item, fieldName) => {\n    if (item === null || item === undefined || typeof item !== 'object') return false;\n    if (fieldName in item) return true;\n    const parts = fieldName.split('.');\n    let current = item;\n    for (let i = 0; i < parts.length - 1; i++) {\n      if (current === null || current === undefined || typeof current !== 'object') return false;\n      current = current[parts[i]];\n    }\n    return current != null && typeof current === 'object' && parts[parts.length - 1] in current;\n  };\n\n  const applyTransformation = (value, type) => {\n    if (value === null || value === undefined) return value;\n    switch (type) {\n      case 'uppercase':\n        if (typeof value === 'string') return value.toUpperCase();\n        if (Array.isArray(value)) return value.map(v => applyTransformation(v, type));\n        if (typeof value === 'object') {\n          const r = {};\n          for (const k in value) r[k] = applyTransformation(value[k], type);\n          return r;\n        }\n        return value;\n      case 'lowercase':\n        if (typeof value === 'string') return value.toLowerCase();\n        if (Array.isArray(value)) return value.map(v => applyTransformation(v, type));\n        if (typeof value === 'object') {\n          const r = {};\n          for (const k in value) r[k] = applyTransformation(value[k], type);\n          return r;\n        }\n        return value;\n      case 'trim':\n        if (typeof value === 'string') return value.trim();\n        if (Array.isArray(value)) return value.map(v => applyTransformation(v, type));\n        if (typeof value === 'object') {\n          const r = {};\n          for (const k in value) r[k] = applyTransformation(value[k], type);\n          return r;\n        }\n        return value;\n      default:\n        return value;\n    }\n  };\n\n  const mapItem = (item) => {\n    if (item === null || item === undefined) return item;\n    if (typeof item !== 'object' || Array.isArray(item)) return item;\n\n    const result = false ? { ...item } : {};\n\n    for (const m of mappings) {\n      if (!hasField(item, m.field)) continue;\n      const value = getFieldValue(item, m.field);\n      const outputKey = m.renameTo || m.field;\n      const transformed = applyTransformation(value, m.transformation);\n\n      if (false && m.renameTo && m.renameTo !== m.field) {\n        delete result[m.field];\n      }\n\n      result[outputKey] = transformed;\n    }\n\n    return result;\n  };\n\n  if (!Array.isArray($collection)) return mapItem($collection);\n  return $collection.map(mapItem);\n}"
            },
