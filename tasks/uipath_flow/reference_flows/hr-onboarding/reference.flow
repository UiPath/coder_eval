      "display": {
        "label": "Send Message to User",
        "subLabel": "",
        "iconBackground": "linear-gradient(225deg, #FAFAFB 0%, #ECEDEF 100%)",
        "iconBackgroundDark": "linear-gradient(225deg, #526069 0%, rgba(50, 60, 66, 0.6) 100%)",
        "icon": "https://staging.uipath.com/82e69757-09ff-4e6d-83e7-d530f2ac4e7b/studio_/typecache/icons/8af239e6c82c1abd57622314380112d55f7e151ac4845ba018a96d70b4d92297.svg",
        "description": "(Slack) Send a message to an individual user in Slack."
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "dffcbd0e-a0b2-4fed-8edb-0a7134fc1393",
          "connectionResourceId": "dffcbd0e-a0b2-4fed-8edb-0a7134fc1393",
          "connectionFolderKey": "72d8d5bd-6b25-474b-aa2f-1caa11abae53",
          "method": "POST",
          "endpoint": "/send_message_to_user_v2",
          "queryParameters": {
            "send_as": "bot"
          },
          "bodyParameters": {
            "channel": "=js:($vars.manualTrigger1.output.prehireemail)",
            "messageToSend": "=js:((() => {\n  const today = new Date();\n  today.setMonth(today.getMonth() + 2);\n  const day = String(today.getDate()).padStart(2, '0');\n  const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\n  const month = monthNames[today.getMonth()];\n  const year = today.getFullYear();\n  return \"*Notification for Payroll Manager:* Onboarding new member -\" + $vars.aoHroValidatedocuments2.out_FirstName + \" \" + $vars.aoHroValidatedocuments2.out_LastName + \" for \" + $vars.manualTrigger1.output.in_JobRole2 + \" role. Date of Joining -\" + `${day}-${month}-${year}` + \".\";\n})())"
          },
          "configuration": "=jsonString:{\"_textBlocks\":[{\"name\":\"defaultMessage\",\"text\":\"Supports multiple button actions. Provide each action in comma-separated format: action ID (Unique & Required), action name (Required), style (primary/danger), confirmation title, confirmation text, confirm ok title, confirm deny title. You can specify up to 5 actions, with each action separated by a semicolon.\"},{\"name\":\"defaultMessage\",\"text\":\"Displays name-value pairs in a two-column layout. Provide field names and values separated by a semicolon. Example: Name: John Doe; Age: 30; Location: New York.\"}],\"objectActions\":[],\"connectorName\":\"Slack\",\"connectorVersion\":\"2.13.7\",\"executionType\":null,\"maxPageSize\":1000,\"customFieldsRequestDetails\":null,\"jobArguments\":null,\"isAutopilotInvalidConfig\":false,\"additionalHeaders\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_user_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"method\"},\"objectName\":\"send_message_to_user_v2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"cachedLookupValues\":[[\"channel\",null]],\"cachedBrowserItems\":[],\"cachedPropertyMappings\":[],\"primaryKeys\":[],\"httpMethod\":\"POST\",\"objectDisplayName\":\"Send message to user\",\"baseObject\":null,\"eventMode\":null,\"eventOperation\":null,\"path\":\"/send_message_to_user_v2\",\"language\":\"en-US\",\"hasBreakingChanges\":false,\"fieldsContainer\":{\"outputTypeDefinition\":\"{\\\"app_id\\\":string;\\\"blocks\\\":{\\\"block_id\\\":string;\\\"text\\\":{\\\"emoji\\\":boolean;\\\"text\\\":string;\\\"type\\\":string};\\\"type\\\":string}[];\\\"channel\\\":string;\\\"icons\\\":{\\\"emoji\\\":string};\\\"message\\\":{\\\"app_id\\\":string;\\\"attachments\\\":{\\\"actions\\\":{\\\"confirm\\\":{\\\"dismiss_text\\\":string;\\\"ok_text\\\":string;\\\"text\\\":string;\\\"title\\\":string}