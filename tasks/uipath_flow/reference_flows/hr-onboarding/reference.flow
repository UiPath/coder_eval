          "bodyParameters": {
            "message.toRecipients": "=js:($vars.manualTrigger1.output.prehireemail)",
            "message.subject": "Welcome to Acme Inc.! Next Steps for Your Onboarding",
            "message.body.content": "=js:(\"<html>\" +\"<head>\" +\"<style>\" +\"  body { font-family: 'Segoe UI', sans-serif; color: #333333; }\" +\"  .container { max-width: 600px; margin: auto; padding: 20px; border: 1px solid #e0e0e0; border-radius: 8px; background-color: #f9f9f9; }\" +\"  h2 { color: #0066cc; }\" +\"  ul { padding-left: 20px; }\" +\"</style>\" +\"</head>\" +\"<body>\" +\"<div class='container'>\" +\"  <h2>Welcome to Acme Inc.!</h2>\" +\"  <p>Dear Candidate,</p>\" +\"  <p>Congratulations and welcome to <strong>Acme Inc.</strong>! We’re thrilled to have you join our team and are excited about the journey ahead.</p>\" +\"  <p>To ensure a smooth onboarding process, we kindly request you to submit the following documents at your earliest convenience:</p>\" +\"  <ul>\" +\"    <li>A copy of a <strong>Government-issued ID card</strong></li>\" +\"    <li>Completed and signed <strong>W4 Form</strong></li>\" +\"    <li>Your <strong>University Certificate</strong> (final/degree certificate)</li>\" +\"  </ul>\" +\"  <p>You may reply to this email with scanned copies or upload it to the company portal.</p>\" +\"  <p>If you have any questions or need further assistance, please feel free to reach out.</p>\" +\"  <p>We look forward to working with you and once again, welcome aboard!</p>\" +\"  <p>Warm regards,<br/>\" +\"  <strong>Talent Acquisition Team</strong><br/>\" +\"  Acme Inc.</p>\" +\"</div>\" +\"</body>\" +\"</html>\")"
          },
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
