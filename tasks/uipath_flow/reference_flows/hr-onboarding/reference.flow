                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "data": {
                    "label": "Default"
                  }
                },
                {
                  "condition": "hasEdgeFromHandle('error')",
                  "id": "_Implicit_EndEvent_Failure_{nodeId}",
                  "type": "bpmn:EndEvent",
                  "parentId": "{nodeId}",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "data": {
                    "label": "Failure",
                    "model": {
                      "serviceType": "BPMN.Variables",
                      "outputs": [
                        {
