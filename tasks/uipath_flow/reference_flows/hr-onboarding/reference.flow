      "display": {
        "label": "Send Email",
        "subLabel": "Send an offer letter to the employee",
        "iconBackground": "linear-gradient(225deg, #FAFAFB 0%, #ECEDEF 100%)",
        "iconBackgroundDark": "linear-gradient(225deg, #526069 0%, rgba(50, 60, 66, 0.6) 100%)",
        "icon": "https://staging.uipath.com/82e69757-09ff-4e6d-83e7-d530f2ac4e7b/studio_/typecache/icons/160499b52f7cea190b530fe6f40da7ee03455a8d3fb72dd7f4f68d61e7865a3a.svg",
        "description": "(Microsoft Outlook 365) Send an email message based on the input parameters"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "eef31f03-37fb-4827-8b17-3f9d4880a196",
          "connectionResourceId": "ae236dd3-fb0e-41a6-b412-68495dac9bed",
          "connectionFolderKey": "dfac03c4-b7d6-44f6-86b9-6f61bdd2c681",
          "method": "POST",
          "endpoint": "/hubs/productivity/send-mail-v2",
          "queryParameters": {
            "saveAsDraft": true
          },
          "bodyParameters": {
            "message.toRecipients": "=js:($vars.out_PreHireEmail)",
            "message.subject": "=js:([ \"Offer of Employment - \", $vars.out_JobRole ].join(''))",
            "message.body.content": "=js:(() => {\n  const today = new Date();\n  today.setMonth(today.getMonth() + 2);\n  const day = String(today.getDate()).padStart(2, '0');\n  const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\n  const month = monthNames[today.getMonth()];\n  const year = today.getFullYear();\n  const formattedDate = `${day}-${month}-${year}`;\n\n  return \"<html>\" +\n    \"<head>\" +\n    \"  <style>\" +\n    \"    body { font-family: 'Segoe UI', sans-serif; color: #333333; }\" +\n    \"    .container { max-width: 600px; margin: auto; padding: 20px; border: 1px solid #e0e0e0; border-radius: 8px; background-color: #f9f9f9; }\" +\n    \"    h2 { color: #0066cc; }\" +\n    \"    .button { display: inline-block; margin-top: 20px; padding: 10px 20px; background-color: #0066cc; color: #ffffff; text-decoration: none; border-radius: 4px; }\" +\n    \"  </style>\" +\n    \"</head>\" +\n    \"<body>\" +\n    \"  <div class='container'>\" +\n    \"    <h2>Offer of Employment - \" + $vars.out_JobRole + \"</h2>\" +\n    \"    <p>Dear Candidate,</p>\" +\n    \"    <p>We are pleased to extend to you an offer of employment for the position of <strong>\" + $vars.out_PreHireEmail + \"</strong> at <strong>Acme Inc.</strong>.</p>\" +\n    \"    <p>Your expected date of joining will be <strong>\" + formattedDate + \"</strong>. To accept this offer, please sign and return a copy of this letter in 15 days. If we do not receive your acceptance by this date, this offer will be considered withdrawn.</p>\" +\n    \"    <p>We are excited to have you join our growing team and look forward to the skills and passion you will bring to the organization.</p>\" +\n    \"    <p>Warm regards,<br/>\" +\n    \"    <strong>Talent Acquisition Team</strong><br/>\" +\n    \"    Acme Inc.</p>\" +\n    \"  </div>\" +\n    \"</body>\" +\n    \"</html>\";\n})()"
          },
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "configuration": "=jsonString:{\"_textBlocks\":[],\"objectActions\":[],\"connectorName\":\"Microsoft Outlook 365\",\"connectorVersion\":\"1.35.40\",\"executionType\":null,\"maxPageSize\":1000,\"customFieldsRequestDetails\":null,\"jobArguments\":null,\"isAutopilotInvalidConfig\":false,\"additionalHeaders\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"send-mail-v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send-mail-v2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"cachedLookupValues\":[],\"cachedBrowserItems\":[],\"cachedPropertyMappings\":[],\"primaryKeys\":[],\"httpMethod\":\"POST\",\"objectDisplayName\":\"Send Mail\",\"baseObject\":null,\"eventMode\":null,\"eventOperation\":null,\"path\":\"/hubs/productivity/send-mail-v2\",\"language\":\"en-US\",\"hasBreakingChanges\":false,\"fieldsContainer\":{\"outputTypeDefinition\":\"{\\\"status\\\":string}\",\"outputJsonSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"status\":{\"title\":\"Status\",\"type\":\"string\"}},\"definitions\":{}},\"inputFields\":[{\"typeScriptDefinition\":null,\"id\":\"saveAsDraft\",\"name\":\"saveAsDraft\",\"displayName\":\"Save as draft\",\"description\":\"Send an email message. By default, the email will be saved as draft.\",\"type\":\"boolean\",\"sortOrder\":1,\"defaultValue\":true,\"primaryKey\":false,\"design\":{\"loadByDefault\":false,\"isMultiSelect\":false,\"enableUserOverride\":false,\"isHidden\":false,\"position\":\"primary\",\"validation\":false},\"fieldActions\":null,\"searchable\":false,\"searchableOperators\":null,\"searchableNames\":null,\"required\":false,\"request\":true,\"response\":false,\"responseCurated\":false,\"fieldLocation\":\"query\",\"onCanvas\":true,\"isJitField\":false,\"isFieldActionParent\":false,\"isMainResponseField\":false,\"isMethodParam