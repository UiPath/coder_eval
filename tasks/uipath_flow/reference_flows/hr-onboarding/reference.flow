      "display": {
        "label": "Create issue in Jira",
        "subLabel": "",
        "iconBackground": "linear-gradient(225deg, #FAFAFB 0%, #ECEDEF 100%)",
        "iconBackgroundDark": "linear-gradient(225deg, #526069 0%, rgba(50, 60, 66, 0.6) 100%)",
        "icon": "app-window"
      },
      "inputs": {
        "mode": "manual",
        "method": "POST",
        "url": "https://uipathlabs.atlassian.net/rest/api/3/issue",
        "swaggerDefinition": null,
        "authenticationType": "manual",
        "application": "",
        "connection": "",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "Authorization": "Basic <JIRA_API_TOKEN>"
        },
        "queryParams": {},
        "body": "{\r\n  \"fields\": {\r\n    \"project\": {\r\n      \"key\": \"ITSM\"\r\n    },\r\n    \"issuetype\": {\r\n      \"name\": \"[System] Service request\"\r\n    },\r\n    \"summary\": \"=js:(() => {\r\n      const date = new Date();\r\n      date.setMonth(date.getMonth() + 2);\r\n      const formattedDate = date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-');\r\n      return `Onboarding Request: ${$vars.aoHroValidatedocuments2.out_FirstName || ''} ${$vars.aoHroValidatedocuments2.out_LastName || ''} - ${$vars.manualTrigger1.output.in_JobRole2 || ''} - DOJ: ${formattedDate}`;\r\n    })()\",\r\n    \"description\": {\r\n      \"type\": \"doc\",\r\n      \"version\": 1,\r\n      \"content\": [\r\n        {\r\n          \"type\": \"paragraph\",\r\n          \"content\": [\r\n            {\r\n              \"type\": \"text\",\r\n              \"text\": \"Tasks to be completed: Provision laptop (Request Raised) and accessories, create corporate email and user account (AD/SSO), grant access to internal tools (Jira, Confluence, GitHub/Bitbucket, Teams), configure VPN and remote access, set up development environment and licenses (IDE license such as Visual Studio or IntelliJ, UiPath Studio license, Postman, DB tools, and other relevant apps), and enroll the device in endpoint security and compliance systems. Please ensure all onboarding steps are completed prior to the candidate's first day.\"\r\n            }\r\n          ]\r\n        }\r\n      ]\r\n    },\r\n    \"components\": [\r\n      {\r\n        \"name\": \"HR Services\"\r\n      }\r\n    ]\r\n  }\r\n}",
        "contentType": "application/json",
        "timeout": "PT15M",
        "retryCount": 0,
        "branches": []
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "HTTP response object",
          "source": "=response",
