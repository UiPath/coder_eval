    {
      "id": "sendEmail5",
      "type": "uipath.connector.uipath-microsoft-outlook365.send-email",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 1568,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Initiate background check",
        "subLabel": "",
        "iconBackground": "linear-gradient(225deg, #FAFAFB 0%, #ECEDEF 100%)",
        "iconBackgroundDark": "linear-gradient(225deg, #526069 0%, rgba(50, 60, 66, 0.6) 100%)",
        "icon": "https://staging.uipath.com/82e69757-09ff-4e6d-83e7-d530f2ac4e7b/studio_/typecache/icons/160499b52f7cea190b530fe6f40da7ee03455a8d3fb72dd7f4f68d61e7865a3a.svg",
        "description": "(Microsoft Outlook 365) Send an email message based on the input parameters"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "526209ee-69d0-43e6-8e8c-43a1f0155d7b",
          "connectionResourceId": "ae236dd3-fb0e-41a6-b412-68495dac9bed",
          "connectionFolderKey": "72d8d5bd-6b25-474b-aa2f-1caa11abae53",
          "method": "POST",
          "endpoint": "/hubs/productivity/send-mail-v2",
          "queryParameters": {
            "saveAsDraft": true
          },
          "bodyParameters": {
            "message.toRecipients": "=js:($vars.manualTrigger1.output.prehireemail)",
            "message.subject": "=js:(\"Background Verification Request for\"+ $vars.aoHroValidatedocuments2.out_FirstName +\" \"+$vars.aoHroValidatedocuments2.out_LastName+\" – \"+$vars.out_JobRole+ \"at Acme Inc.\")",
            "message.body.content": "=js:(\"<html>\" +\"<head>\" +\"<style>\" +\"  body { font-family: 'Segoe UI', sans-serif; color: #333333; background-color: #f5f7fa; margin: 0; padding: 0; }\" +\"  .container { max-width: 600px; margin: 40px auto; background-color: #ffffff; border-radius: 10px; box-shadow: 0 2px 6px rgba(0,0,0,0.1); padding: 30px; }\" +\"  .header { border-bottom: 2px solid #0073e6; padding-bottom: 10px; margin-bottom: 20px; }\" +\"  .header h2 { color: #0073e6; margin: 0; }\" +\"  .content p { line-height: 1.6; }\" +\"  .footer { margin-top: 30px; font-size: 0.9em; color: #888888; }\" +\"</style>\" +\"</head>\" +\"<body>\" +\"  <div class='container'>\" +\"    <div class='header'>\" +\"      <h2>Background Verification Request</h2>\" +\"    </div>\" +\"    <div class='content'>\" +\"      <p>Dear Verification Team,</p>\" +\"      <p>We request you to initiate background verification for the following candidate who has been offered a position at <strong>Acme Inc.</strong>:</p>\" +\"      <table style='width:100%; margin-top: 10px; margin-bottom: 20px; font-size: 15px;'>\" +\"        <tr><td><strong>Candidate Name:</strong></td><td>\"+$vars.aoHroValidatedocuments2.out_FirstName,$vars.aoHroValidatedocuments2.out_LastName+\"</td></tr>\" +\"        <tr><td><strong>Job Role:</strong></td><td>\"+$vars.out_JobRole+\"</td></tr>\" +\"        <tr><td><strong>Contact Email:</strong></td><td>\"+$vars.manualTrigger1.output.prehireemail+\"</td></tr>\" +\"      </table>\" +\"      <p>Please proceed with the standard background check which includes:</p>\" +\"      <ul>\" +\"        <li>Identity and Address Verification</li>\" +\"        <li>Education Qualification Verification</li>\" +\"        <li>Previous Employment History Check</li>\" +\"        <li>Criminal Background Check</li>\" +\"      </ul>\" +\"      <p>Let us know if any additional documents are needed from our side to complete this process.</p>\" +\"      <p>Thank you for your prompt assistance.</p>\" +\"      <p>Best regards,<br/><strong>HR Team</strong><br/>Acme Inc.</p>\" +\"    </div>\" +\"    <div class='footer'>\" +\"      <p>This is a system-generated message. For queries, please contact hr@acme.com</p>\" +\"    </div>\" +\"  </div>\" +\"</body>\" +\"</html>\")"
          },
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "configuration": "=jsonString:{\"_textBlocks\":[],\"objectActions\":[],\"connectorName\":\"Microsoft Outlook 365\",\"connectorVersion\":\"1.35.42\",\"executionType\":null,\"maxPageSize\":1000,\"customFieldsRequestDetails\":null,\"jobArguments\":null,\"isAutopilotInvalidConfig\":false,\"additionalHeaders\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"send-mail-v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send-mail-v2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"cachedLookupValues\":[],\"cachedBrowserItems\":[],\"cachedPropertyMappings\":[],\"primaryKeys\":[],\"httpMethod\":\"POST\",\"objectDisplayName\":\"Send Mail\",\"baseObject\":null,\"eventMode\":null,\"eventOperation\":null,\"path\":\"/hubs/productivity/send-mail-v2\",\"language\":\"en-US\",\"hasBreakingChanges\":false,\"fieldsContainer\":{\"outputTypeDefinition\":\"{\\\"status\\\":string}\",\"outputJsonSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"status\":{\"title\":\"Status\",\"type\":\"string\"}},\"definitions\":{}},\"inputFields\":[{\"typeScriptDefinition\":null,\"id\":\"saveAsDraft\",\"name\":\"saveAsDraft\",\"displayName\":\"Save as draft\",\"description\":\"Send an email message. By default, the email will be saved as draft.\",\"type\":\"boolean\",\"sortOrder\":1,\"defaultValue\":true,\"primaryKey\":false,\"design\":{\"loadByDefault\":false,\"isMultiSelect\":false,\"enableUserOverride\":false,\"isHidden\":false,\"position\":\"primary\",\"validation\":false},\"fieldActions\":null,\"searchable\":false,\"searchableOperators\":null,\"searchableNames\":null,\"required\":false,\"request\":true,\"response\":false,\"responseCurated\":false,\"fieldLocation\":\"query\",\"onCanvas\":true,\"isJitField\":false,\"isFieldActionParent\":false,\"isMainResponseField\":false,\"isMethodParam