    {
      "id": "extractTemperature1",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 600,
          "y": 144
        }
      },
      "display": {
        "label": "Extract Temperature"
      },
      "inputs": {
        "script": "return { temp: $vars.fetchDenverTemperature1.output.body.current.temperature_2m };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      }
    },
    {
      "id": "tempOver60f1",
      "type": "core.logic.decision",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 800,
          "y": 144
        }
      },
      "display": {
        "label": "Temp over 60F"
      },
      "inputs": {
        "trueLabel": "True",
        "falseLabel": "False",
        "expression": "$vars.extractTemperature1.output.temp > 60"
      },
      "model": {
        "type": "bpmn:InclusiveGateway"
      }
    },
