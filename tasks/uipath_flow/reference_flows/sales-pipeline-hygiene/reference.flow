    {
      "id": "loop1",
      "type": "core.logic.loop",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 464,
          "y": -16
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Loop Opportunities",
        "subLabel": "Executed in parallel for each opportunity",
        "icon": "repeat",
        "description": "Execute a sequence of actions repeatedly for each item in a collection"
      },
      "inputs": {
        "collection": "=js:$vars.opportunities.output",
        "parallel": true
      },
      "outputs": {
        "currentItem": {
          "type": "any",
          "description": "The current item being iterated in the loop",
          "scope": "internal",
          "source": "=loopContext.currentItem",
          "var": "currentItem"
        },
        "currentIndex": {
          "type": "number",
          "description": "The current iteration index (0-based)",
          "scope": "internal",
          "source": "=loopContext.currentIndex",
          "var": "currentIndex"
        },
        "collection": {
          "type": "array",
          "description": "The collection being iterated over",
          "scope": "internal",
          "source": "=loopContext.collection",
          "var": "collection"
        },
        "output": {
          "type": "array",
          "description": "Aggregated results from all loop iterations",
          "scope": "external",
          "source": "=loopContext.output",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          },
          "source": "=Error",
          "var": "error"
        }
      },
      "model": {
        "type": "bpmn:SubProcess"
      }
    },
    {
      "id": "switch1",
      "type": "core.logic.switch",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 816,
          "y": 112
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Risk Level",
        "subLabel": "Take respective path based on risk level",
        "iconBackground": "linear-gradient(225deg, #FAFAFB 0%, #ECEDEF 100%)",
        "iconBackgroundDark": "linear-gradient(225deg, #526069 0%, rgba(50, 60, 66, 0.6) 100%)",
        "icon": "between-horizontal-start"
      },
      "inputs": {
        "cases": [
          {
            "id": "default-1",
            "label": "high",
            "expression": "$vars.riskAssessmentAgent1.riskLevel === \"High\""
          },
          {
            "id": "default-2",
            "label": "medium",
            "expression": "$vars.riskAssessmentAgent1.riskLevel === \"Medium\""
          },
          {
            "id": "mmv0dhnn-uhezv",
            "label": "low",
            "expression": "$vars.riskAssessmentAgent1.riskLevel === \"Low\""
          }
        ],
        "hasDefault": false
      },
      "model": {
        "type": "bpmn:ExclusiveGateway"
      },
      "parentId": "loop1"
    },
    {
      "id": "sendMessageToUser1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-user",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 1568,
          "y": -48
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Send message",
        "subLabel": "Informs the opportunity owner of emerging risk",
        "iconBackground": "linear-gradient(225deg, #FAFAFB 0%, #ECEDEF 100%)",
        "iconBackgroundDark": "linear-gradient(225deg, #526069 0%, rgba(50, 60, 66, 0.6) 100%)",
        "icon": "https://staging.uipath.com/cbae914a-640b-47b3-ada2-c5f747714078/studio_/typecache/icons/8af239e6c82c1abd57622314380112d55f7e151ac4845ba018a96d70b4d92297.svg",
        "description": "(Slack) Send a message to an individual user in Slack."
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "4b76d9ea-0030-4015-ac20-5f9e51a3c11f",
          "connectionResourceId": "4b76d9ea-0030-4015-ac20-5f9e51a3c11f",
          "connectionFolderKey": "e74470b1-6e14-4c87-8bcd-55fa12d2ce8a",
          "method": "POST",
          "endpoint": "/send_message_to_user_v2",
          "queryParameters": {
            "send_as": "bot"
          },
          "bodyParameters": {
            "channel": "=js:($vars.getUserByEmailOrUserId1.output.id)",
            "messageToSend": "=js:(`*Opportunity Risk Alert: ${$vars.loop1.currentItem.Name}*\n\n*Owner:* ${$vars.loop1.currentItem.Owner.Email}\n*Risk Level:* ${$vars.riskAssessmentAgent1.riskLevel}\n*Risk Score:* ${$vars.riskAssessmentAgent1.riskScore}\n\n*Risk Summary:*\n${$vars.riskAssessmentAgent1.riskSummary}\n\n*Recommendations:*\n${$vars.riskAssessmentAgent1.recommendations.map(r => `- ${r}`).join('\\n')}`)"
          },
          "configuration": "=jsonString:{\"_textBlocks\":[{\"name\":\"defaultMessage\",\"text\":\"Supports multiple button actions. Provide each action in comma-separated format: action ID (Unique & Required), action name (Required), style (primary/danger), confirmation title, confirmation text, confirm ok title, confirm deny title. You can specify up to 5 actions, with each action separated by a semicolon.\"},{\"name\":\"defaultMessage\",\"text\":\"Displays name-value pairs in a two-column layout. Provide field names and values separated by a semicolon. Example: Name: John Doe; Age: 30; Location: New York.\"}],\"objectActions\":[],\"connectorName\":\"Slack\",\"connectorVersion\":\"2.13.7\",\"executionType\":null,\"maxPageSize\":1000,\"customFieldsRequestDetails\":null,\"jobArguments\":null,\"isAutopilotInvalidConfig\":false,\"additionalHeaders\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_user_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"method\"},\"objectName\":\"send_message_to_user_v2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"cachedLookupValues\":[[\"channel\",null]],\"cachedBrowserItems\":[],\"cachedPropertyMappings\":[],\"primaryKeys\":[],\"httpMethod\":\"POST\",\"objectDisplayName\":\"Send message to user\",\"baseObject\":null,\"eventMode\":null,\"eventOperation\":null,\"path\":\"/send_message_to_user_v2\",\"language\":\"en-US\",\"hasBreakingChanges\":false,\"fieldsContainer\":{\"outputTypeDefinition\":\"{\\\"app_id\\\":string;\\\"blocks\\\":{\\\"block_id\\\":string;\\\"text\\\":{\\\"emoji\\\":boolean;\\\"text\\\":string;\\\"type\\\":string};\\\"type\\\":string}[];\\\"channel\\\":string;\\\"icons\\\":{\\\"emoji\\\":string};\\\"message\\\":{\\\"app_id\\\":string;\\\"attachments\\\":{\\\"actions\\\":{\\\"confirm\\\":{\\\"dismiss_text\\\":string;\\\"ok_text\\\":string;\\\"text\\\":string;\\\"title\\\":string}