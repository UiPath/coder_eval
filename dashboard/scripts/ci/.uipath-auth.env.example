# Credentials for refresh-auth.sh (this directory). Sourced by the
# uip-refresh-auth.service systemd unit on the CI VM (via EnvironmentFile=).
# Real CE_PASSWORD is not stored in this repo — ask the team for the current value.
# Keep mode 600. Never commit a populated copy.
#
# Format note: this file is also parsed by systemd's EnvironmentFile= parser,
# which is stricter than bash — KEY=value, no quoting, no inline comments.

UIPATH_URL=https://alpha.uipath.com
UIPATH_ORGANIZATION_NAME=codereval
UIPATH_ORGANIZATION_ID=311c6049-4966-4ef2-a6f3-8ceccaf38d54
UIPATH_TENANT_NAME=DefaultTenant
UIPATH_TENANT_ID=69d43765-6ede-4575-88b7-9db601a2c056

# CLIENT_ID / CLIENT_SECRET below are the well-known first-party password-grant
# client (note they're identical — it's a public client masquerading as a
# confidential one). The real auth factor is CE_PASSWORD. Safe to keep in this
# internal repo; would strip if coder_eval ever flips to public.
CLIENT_ID=0afb5a31-3a84-4adb-ab6e-b38eee458dd4
CLIENT_SECRET=0afb5a31-3a84-4adb-ab6e-b38eee458dd4
CE_USERNAME=coder-eval-bot@uipath-qa.com
CE_PASSWORD=replace-me
