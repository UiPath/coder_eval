[Unit]
Description=coder-eval daily eval suite
Documentation=https://github.com/UiPath/coder_eval/blob/main/dashboard/CI_DESIGN.md

[Service]
Type=oneshot
WorkingDirectory=/home/azureuser/uipath/coder_eval
# Secrets are sourced from repo .env files inside daily.sh — no separate
# EnvironmentFile required. To override (e.g. ad-hoc smoke tests), use:
#   systemctl --user edit coder-eval-daily.service
ExecStart=/home/azureuser/uipath/coder_eval/dashboard/scripts/ci/daily.sh
TimeoutStartSec=4h
Nice=5

[Install]
WantedBy=default.target
