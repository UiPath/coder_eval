# ADX (Azure Data Explorer)
ADX_CLUSTER_URI=https://your-cluster.region.kusto.windows.net
ADX_DATABASE=your-database-name

# Azure
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_STORAGE_ACCOUNT=yourstorageaccount
AZURE_BLOB_CONTAINER=runs
# Storage account access key. Optional fallback used only when an `az login`
# / Managed Identity with Storage Blob Data Contributor isn't available.
# Default path: `--auth-mode login` against the active identity. Setting this
# switches blob upload + pull to `--auth-mode key`.
# AZURE_STORAGE_KEY=

# Skills repo path (default: sibling directory of coder_eval repo)
# SKILLS_DIR=/home/ubuntu/src/repos/skills

# UiPath CLI login (required for flow suites)
# UIP_AUTHORITY=https://alpha.uipath.com/identity_
# UIP_CLIENT_ID=
# UIP_CLIENT_SECRET=
# UIP_TENANT=
# UIP_SCOPE=OR.Default
