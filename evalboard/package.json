{
    "name": "evalboard",
    "private": true,
    "packageManager": "pnpm@10.9.0",
    "scripts": {
        "dev": "next dev -p 3030",
        "dev:local": "EVALBOARD_LOCAL_RUNS_DIR=../runs next dev -p 3030",
        "build": "next build",
        "start": "next start -p 3030",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "verify": "tsc --noEmit && vitest run && next build"
    },
    "dependencies": {
        "next": "^16.2.10",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-markdown": "^10.1.0",
        "recharts": "^3.9.2",
        "remark-gfm": "^4.0.1"
    },
    "optionalDependencies": {
        "@azure/identity": "^4.13.1",
        "@azure/storage-blob": ">=12.31.0 <12.34.0"
    },
    "devDependencies": {
        "@tailwindcss/typography": "^0.5.19",
        "@testing-library/jest-dom": "^6.0.0",
        "@testing-library/react": "^16.0.0",
        "@types/node": "^22.10.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^6.0.3",
        "@vitest/coverage-v8": "^4.1.10",
        "autoprefixer": "^10.4.20",
        "jsdom": "^29.1.1",
        "postcss": "^8.4.49",
        "tailwindcss": "^4.3.2",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "pnpm": {
        "overrides": {
            "postcss": "^8.5.10",
            "fast-xml-builder": "^1.1.7",
            "@babel/core": "^7.29.6",
            "uuid": "^11.1.1"
        }
    }
}
