{
    "name": "evalboard",
    "private": true,
    "packageManager": "pnpm@10.9.0",
    "scripts": {
        "dev": "next dev -p 3030",
        "dev:local": "EVALBOARD_LOCAL_RUNS_DIR=../runs next dev -p 3030",
        "build": "next build",
        "start": "next start -p 3030",
        "typecheck": "tsc --noEmit",
        "verify": "tsc --noEmit && next build"
    },
    "dependencies": {
        "@azure/identity": "^4.13.1",
        "@azure/storage-blob": "^12.31.0",
        "next": "^15.1.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-markdown": "^10.1.0",
        "recharts": "^2.15.0",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@tailwindcss/typography": "^0.5.19",
        "@types/node": "^22.10.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.6.3"
    }
}
