{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-doctor/status_v1.json",
  "title": "runs/<run_id>/skill-doctor/status.json (contract v1)",
  "description": "Pointer and lock for one nightly run's doctor output. Written first as a create-if-absent lock (state running), last on success. triage_file names the immutable triage-<build>.json next to it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "reason", "run_id", "harness", "model", "history_base_run", "run_json_etag",
               "started_at", "finished_at", "doctor_version", "build_id", "build_url", "cost_usd", "rows_failed",
               "rows_diagnosed", "triage_file"],
  "properties": {
    "schema_version": {"const": 1},
    "state": {"enum": ["queued", "running", "done", "failed", "skipped", "retracted"]},
    "reason": {"type": "string", "maxLength": 500},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"},
    "harness": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "adhoc": {"type": "boolean"},
    "triage_only": {"type": "boolean"},
    "history_base_run": {"type": ["string", "null"]},
    "run_json_etag": {"type": ["string", "null"]},
    "started_at": {"type": "string"},
    "finished_at": {"type": ["string", "null"]},
    "updated_at": {"type": "string"},
    "doctor_version": {"type": "string"},
    "build_id": {"type": ["string", "null"]},
    "build_url": {"type": ["string", "null"]},
    "cost_usd": {"type": "number", "minimum": 0},
    "cost_complete": {"type": "boolean", "description": "false when a session's cost is unknown (timed out / killed): cost_usd counts it as 0, reason says which group"},
    "rows_failed": {"type": ["integer", "null"], "minimum": 0},
    "rows_diagnosed": {"type": "integer", "minimum": 0},
    "triage_file": {"type": ["string", "null"], "pattern": "^triage-[A-Za-z0-9._-]+\\.json$"},
    "trigger": {"type": ["string", "null"], "pattern": "^https://dev\\.azure\\.com/[A-Za-z0-9-]+/[A-Za-z0-9._%-]+/_build/results\\?buildId=[0-9]+$",
                "description": "the nightly build that queued this run (the sourceBuild parameter); null when queued by hand"},
    "fixes_dir": {"type": ["string", "null"], "pattern": "^fixes(-[0-9]+)?$",
                  "description": "the Fix stage's create-only dir next to this file (fixes.json, <id>.patch, <id>.md); set by FixEmit"},
    "fixes_dirs": {"type": "array", "items": {"type": "string", "pattern": "^fixes(-[0-9]+)?$"},
                   "description": "every Fix stage's dir of this run, oldest first (fixes_dir is the newest): the memory of the next nights reads them all"},
    "fixes": {"type": "object", "additionalProperties": false, "required": ["fix_mode", "cost_usd", "counts"],
              "description": "FixEmit's digest of fixes.json: candidates per outcome (pr-ready, needs-live-run, held-overlap, ...)",
              "properties": {
                "fix_mode": {"enum": ["dryrun", "open"]},
                "cost_usd": {"type": "number", "minimum": 0},
                "total_cap_usd": {"type": ["number", "null"], "minimum": 0},
                "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
              }}
  }
}
